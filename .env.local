# Next.js App URL (used for CORS in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.IO Configuration
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000

# Optional: Redis URL for scaling (if you want to use Redis adapter)
# REDIS_URL=redis://localhost:6379

# Optional: Database configuration (if you want to persist messages)
# DATABASE_URL=postgresql://user:password@localhost:5432/gaweapp
